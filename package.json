{
    "name": "rantsija",
    "version": "1.0.1",
    "main": "electron/main.cjs",
    "scripts": {
      "dev": "vite",
      "dev:electron": "concurrently -k \"npm run dev\" \"npm run electron:dev\"",
      "electron:dev": "electron .",
      "build": "vite build",
      "build:electron": "npm run build && electron-builder"
    },
    "build": {
      "appId": "com.rantsija.app",
      "productName": "Rantsija",
      "directories": {
        "output": "release"
      },
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json"
      ],
      "extraResources": [],
      "win": {
        "target": "nsis",
        "icon": "electron/icon.png"
      }
    },


  "dependencies": {
    "@react-google-maps/api": "^2.20.7",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "ffmpeg": "^0.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.0.6",
    "togeojson": "^0.16.0",
    "xmldom": "^0.6.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.3",
    "@tanstack/eslint-config": "^0.3.0",
    "@tanstack/router-cli": "^1.132.45",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
