{
    "appId": "com.rantsija.app",
    "productName": "Rantsija",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      {
        "from": "dist",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "main.cjs",
          "preload.cjs"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rantsija"
    }
  }
